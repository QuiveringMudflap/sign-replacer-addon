    "authors": ["QuiveringMudflap"],
    "contact": {
        "homepage": "https://github.com/QuiveringMudflap/sign-replacer-addon",
        "sources": "https://github.com/QuiveringMudflap/sign-replacer-addon"
    },
    "license": "GPL-3.0",
    "icon": "assets/sign-replacer-addon/icon.png",
    "environment": "client",
    "entrypoints": {
